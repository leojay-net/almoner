{
  "name": "almoner",
  "version": "0.0.0",
  "private": true,
  "description": "Private batch disbursement on STRK20",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@starkware-libs/starknet-privacy-sdk": "file:vendor/starknet-privacy-sdk",
    "prettier": "^3.4.2",
    "starknet": "10.5.0"
  }
}
