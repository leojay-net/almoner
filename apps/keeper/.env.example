# Keeper configuration. Copy to .env and never commit it.

# Starknet RPC. Create a free key at https://www.alchemy.com
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployed Almoner escrow, and the block it was deployed in.
ESCROW_ADDRESS=0x...
ESCROW_FROM_BLOCK=0

# Keeper account. This signs public refund transactions and nothing else - it
# holds no viewing key and no shielded balance, and can only move funds to the
# refund address fixed when each allocation was created. Compromise costs gas,
# not user money. Still: dedicated account, never a personal wallet.
KEEPER_ACCOUNT_ADDRESS=0x...
KEEPER_PRIVATE_KEY=0x...

# Optional
KEEPER_STATE_PATH=.keeper/state.json
KEEPER_INTERVAL_MS=60000
KEEPER_GRACE_SECONDS=120
KEEPER_BATCH_SIZE=25
