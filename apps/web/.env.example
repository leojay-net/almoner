# Copy to .env.local. Never commit .env.local.
#
# Anything prefixed NEXT_PUBLIC_ ships in the public JS bundle. Never put a
# private key or a secret API key behind that prefix.

# Starknet mainnet RPC. Create a free key at https://www.alchemy.com
# Server-side only - no NEXT_PUBLIC_ prefix, so the key stays out of the bundle.
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Public, non-secret chain configuration.
NEXT_PUBLIC_CHAIN_ID=SN_MAIN
NEXT_PUBLIC_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Deployed Almoner escrow. Empty until the contract is deployed.
NEXT_PUBLIC_ESCROW_ADDRESS=

# ── Route B: the SDK route (server-side only) ───────────────────────────────
# Only needed when NEXT_PUBLIC_STRK20_ROUTE=sdk. This route holds keys, so every
# value here is server-side and must never gain a NEXT_PUBLIC_ prefix.
#
# Why it exists: the wallet route cannot reach Sepolia (Ready's STRK20 backend
# returns a 500 there in ~25ms, too fast to have attempted proving), while
# StarkWare does run a Sepolia proving service. The two routes cover different
# networks between them.
NEXT_PUBLIC_STRK20_ROUTE=wallet

# Sepolia proving service. Answers /health.
STRK20_PROVING_URL=https://transaction-prover.alpha-sepolia.sw-dev.io

# A dedicated throwaway account. Never a personal wallet — this route signs
# without a prompt.
STRK20_SDK_ACCOUNT_ADDRESS=0x...
STRK20_SDK_PRIVATE_KEY=0x...

# The privacy viewing key, as a decimal or hex integer. Must be in
# [1, MAX_VIEWING_KEY]; a hex string that is not a valid integer compiles but
# silently derives the wrong channel keys and notes never decrypt.
STRK20_SDK_VIEWING_KEY=
